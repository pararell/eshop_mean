# BE HOST
PORT=4000
SERVER_URL="http://localhost:4000"

# FE HOST
ORIGIN="http://localhost:3000"

# JWT settings
JWT_EXPIRATION="7d"
JWT_SECRET="youhavetochoseone"

COOKIE_KEY="youhavetochoseone"

# Admin emails get a copy of every order and contact message
ADMIN_EMAILS="your@email.com, another@mail.com"

# PostgreSQL: data and sessions (docs/database.md). Local: npm run db:up && npm run db:migrate
# Pending migrations are applied at startup; set DB_MIGRATE_ON_START="false" to only report them
DATABASE_URL="postgres://eshop:eshop@localhost:15432/eshop"

# Only for npm run db:seed (creates this admin if missing)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Emails (order confirmations, contact form) via Resend: https://resend.com
# EMAIL_FROM must use a domain verified in Resend, e.g. "Shop <shop@your-domain.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# Images
CLOUDINARY_NAME="set name from cloudinary api https://cloudinary.com (for images upload)"
CLOUDINARY_KEY="set key from cloudinary api  https://cloudinary.com (for images upload)"
CLOUDINARY_SECRET="set secret from cloudinary api https://cloudinary.com (for images upload)"

# Pay - Stripe (docs/payments.md). Test keys start with sk_test_ / pk_test_
STRIPE_SECRETKEY="set for paying with card for orders with stripe https://stripe.com"
# Signing secret (whsec_...) of the webhook endpoint https://<domain>/api/payments/webhook,
# or the one `stripe listen` prints for local development
STRIPE_WEBHOOK_SECRET=""

# Google login
GOOGLE_CLIENT_ID="set for google login activation"
GOOGLE_CLIENT_SECRET="set for google login activation"

# Recaptcha server key from google
RECAPTCHA_SERVER_KEY="RECAPTCHA_SERVER_KEY"

# Get location from IP - https://geolocation-db.com
GEO_LOCATION_API_KEY="GEO_LOCATION_API_KEY"

# Reverse proxy in front of the app (e.g. "1" for one hop): real client IP for rate limits and
# HTTPS detection for the Secure session cookie. Leave empty without a proxy.
TRUST_PROXY=""
# Per-IP limit per minute on sign-in, sign-up, contact and order endpoints
# RATE_LIMIT_PER_MINUTE="10"

# AI product drafts in the admin editor (docs/ai.md). Off while the key is empty.
# Server-side only: never name these FE_* (FE_ variables are sent to the browser).
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional (defaults shown): model per provider, timeout, output tokens, retry delay, price override. No usage limits.
# AI_MODEL="deepseek-flash"   (deepseek-v4-flash-vision-exp is a retired alias of it)
# AI_TIMEOUT_MS="0"   (0 = no timeout)
# AI_MAX_OUTPUT_TOKENS="8192"
# AI_RETRY_DELAY_MS="1000"
# AI_PRICE_INPUT_PER_MTOK=""
# AI_PRICE_OUTPUT_PER_MTOK=""

# Will be send to FE as config
FE_STRIPE_PUBLISHABLE_KEY="FE_STRIPE_PUBLISHABLE_KEY"
FE_TINYMCE_API_KEY="FE_TINYMCE_API_KEY"
FE_RECAPTCHA_CLIENT_KEY="FE_RECAPTCHA_CLIENT_KEY"

# https://www.googletagmanager.com/gtag Google analytics token
FE_ANALYTICS_TOKEN="FE_ANALYTICS_TOKEN"
