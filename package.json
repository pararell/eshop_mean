{
  "name": "eshop",
  "version": "1.0.0",
  "description": "Ecommerce template",
  "author": "Miroslav Smrtic",
  "private": false,
  "license": "MIT",
  "scripts": {
    "build:server": "NODE_ENV=production nest build --config ./server/nest-cli.json",
    "start:server": "NODE_ENV=production nest start config ./server/nest-cli.json --path ./server/tsconfig.json",
    "start:dev": "NODE_ENV=development nest start --watch config ./server/nest-cli.json --path ./server/tsconfig.json",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node server/dist/main",
    "format": "prettier --write .",
    "lint": "eslint .",
    "ng": "ng ",
    "start:client": "ng serve --port 3000",
    "start:client:https": "ng serve --port 3000 --ssl=true --ssl-key=localhost.key --ssl-cert=localhost.crt",
    "build:client": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev:ssr": "ng run eshop:serve-ssr",
    "serve:ssr": "node dist/eshop/server/server.mjs",
    "build:ssr": "node scripts/build-ssr.mjs",
    "serve:client:prod": "ng serve --configuration production",
    "lint:client": "ng lint",
    "lint:scss": "stylelint **/**.scss --formatter verbose",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "test": "npm run test:server",
    "test:server": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js -c server/jest.config.cjs",
    "test:server:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js -c server/jest.config.cjs --watch",
    "test:server:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js -c server/jest.config.cjs --coverage",
    "test:e2e": "npm run build:ssr && playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "docs:media": "npm run build:ssr && playwright test -c e2e/docs-media.config.ts && node e2e/docs-media/optimize-images.mjs && node e2e/docs-media/make-gif.mjs",
    "start": "npm run serve:ssr",
    "typecheck": "tsc --noEmit -p client/tsconfig.app.json && tsc --noEmit -p server/tsconfig.json && tsc -p server/tsconfig.spec.json && tsc -p e2e/tsconfig.json",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "db:up": "docker compose up -d postgres",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "db:migrate": "tsx server/scripts/db-migrate.ts",
    "db:seed": "tsx server/scripts/db-seed.ts",
    "email:preview": "tsx server/scripts/email-preview.ts"
  },
  "dependencies": {
    "@angular/animations": "22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-browser-dynamic": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/service-worker": "22.2.2",
    "@angular/ssr": "22.2.2",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@tinymce/tinymce-angular": "^8.0.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.2.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "helmet": "8.3.0",
    "multer": "^2.4.0",
    "ngx-cookie-service": "^22.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.1",
    "streamifier": "^0.1.1",
    "stripe": "23.0.0",
    "tinycolor2": "^1.6.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.2",
    "@angular-devkit/schematics": "22.2.2",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/language-service": "22.2.2",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@playwright/test": "^1.64.0",
    "@stripe/stripe-js": "^10.1.0",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^7.2.1",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "angular-eslint": "^22.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "sass": "^1.81.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "whatwg-url": "^14.0.0"
  },
  "engines": {
    "node": "^24.15.0",
    "npm": "^11.4.2"
  },
  "browserslist": [
    "> 5%"
  ],
  "lint-staged": {
    "*.{ts,js,mjs,cjs,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
