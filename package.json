{
  "name": "eshop",
  "version": "0.9.2",
  "description": "Ecommerce template",
  "author": "Miroslav Smrtic",
  "private": false,
  "license": "MIT",
  "scripts": {
    "build:server": "NODE_ENV=production nest build --config ./server/nest-cli.json",
    "start:server": "NODE_ENV=production nest start config ./server/nest-cli.json --path ./server/tsconfig.json",
    "start:dev": "NODE_ENV=development nest start --watch config ./server/nest-cli.json --path ./server/tsconfig.json",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node server/dist/main",
    "format": "prettier --write \"server/**/*.ts\"",
    "lint": "eslint \"{server,apps}/**/*.ts\" --fix",
    "ng": "ng ",
    "start:client": "ng serve --port 3000",
    "start:client:https": "ng serve --port 3000 --ssl=true --ssl-key=localhost.key --ssl-cert=localhost.crt",
    "build:client": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev:ssr": "ng run eshop:serve-ssr",
    "serve:ssr": "node dist/eshop/server/server.mjs",
    "build:ssr": "NODE_ENV=production ng build --configuration production",
    "serve:client:prod": "ng serve --configuration production",
    "lint:client": "ng lint",
    "lint:scss": "stylelint **/**.scss --formatter verbose",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "seed": "npx ts-node --project server/tsconfig.json server/seed.ts",
    "release": "standard-version",
    "start": "npm run serve:ssr"
  },
  "dependencies": {
    "@angular/animations": "~22.0.7",
    "@angular/cdk": "~22.0.5",
    "@angular/common": "~22.0.7",
    "@angular/compiler": "~22.0.7",
    "@angular/core": "~22.0.7",
    "@angular/forms": "~22.0.7",
    "@angular/material": "~22.0.5",
    "@angular/platform-browser": "~22.0.7",
    "@angular/platform-browser-dynamic": "~22.0.7",
    "@angular/platform-server": "~22.0.7",
    "@angular/router": "~22.0.7",
    "@angular/service-worker": "~22.0.7",
    "@angular/ssr": "~22.0.7",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.3",
    "@sendgrid/mail": "^8.1.5",
    "@tinymce/tinymce-angular": "^8.0.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.2.0",
    "connect-sqlite3": "^0.9.17",
    "cookie-parser": "^1.4.7",
    "deepmerge": "4.3.1",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "ngx-cookie-service": "~22.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.1",
    "streamifier": "^0.1.1",
    "stripe": "^9.15.0",
    "tinycolor2": "^1.6.0",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.0.7",
    "@angular-devkit/schematics": "~22.0.7",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "~22.0.7",
    "@angular/cli": "~22.0.7",
    "@angular/compiler-cli": "~22.0.7",
    "@angular/language-service": "~22.0.7",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/serve-static": "^5.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "compression": "^1.8.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify-static": "^4.7.0",
    "prettier": "^3.6.2",
    "saslprep": "1.0.3",
    "sass": "^1.81.0",
    "standard-version": "^9.5.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-scss": "^5.3.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "whatwg-url": "^14.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=6.11.0"
  },
  "browserslist": [
    "> 5%"
  ]
}
