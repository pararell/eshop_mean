{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2018",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@eshop/shared": ["../shared/types/index.d.ts"]
    }
  },
  "files": ["./src/main.ts"],
  "exclude": ["node_modules", "dist", "types.d.ts"]
}
